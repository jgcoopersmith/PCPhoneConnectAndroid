<Window x:Class="PCPhoneConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Phone Connect" Height="820" Width="460"
        MinHeight="600" MinWidth="360" Icon="app.ico"
        MouseDoubleClick="OnWindowDoubleClick"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2A44" />
            <Setter Property="Foreground" Value="#E6ECF5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2B3B5E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A2540" />
            <Setter Property="Foreground" Value="#E6ECF5" />
            <Setter Property="BorderBrush" Value="#2B3B5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#E6ECF5" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB6CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

  <!-- Rounded shell, matching the look of the other widgets. Needs the window to
       be chromeless and transparent, which it already is for real opacity. -->
  <Border x:Name="RootBorder" CornerRadius="14" Background="#0E1726"
          BorderBrush="#22FFFFFF" BorderThickness="1">
  <Grid x:Name="RootGrid" Background="Transparent"
        MouseLeftButtonDown="OnRootMouseDown"
        ContextMenuOpening="OnContextMenuOpening">
    <Grid.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="AlwaysOnTopItem" Header="Always on top"
                      IsCheckable="True" Click="OnAlwaysOnTop" />
            <MenuItem x:Name="StartWithWindowsItem" Header="Start with Windows"
                      IsCheckable="True" Click="OnStartWithWindows" />
            <MenuItem Header="Opacity">
                <MenuItem Header="100%" Tag="1.0" Click="OnOpacity" />
                <MenuItem Header="90%" Tag="0.9" Click="OnOpacity" />
                <MenuItem Header="75%" Tag="0.75" Click="OnOpacity" />
                <MenuItem Header="50%" Tag="0.5" Click="OnOpacity" />
                <MenuItem Header="25%" Tag="0.25" Click="OnOpacity" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="WidgetViewItem" Header="Widget view"
                      IsCheckable="True" Click="OnToggleWidgetFromMenu" />
            <MenuItem Header="Close" Click="OnCloseFromMenu" />
        </ContextMenu>
    </Grid.ContextMenu>

   <Grid.RowDefinitions>
       <RowDefinition Height="Auto" />
       <RowDefinition Height="*" />
   </Grid.RowDefinitions>

   <!-- Custom title bar: the native one is gone because AllowsTransparency
        (needed for real see-through opacity) requires WindowStyle=None. -->
   <Border x:Name="TitleBar" Grid.Row="0" Background="#16223C" CornerRadius="13,13,0,0"
           MouseLeftButtonDown="OnTitleBarDrag">
       <Grid>
           <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
           </Grid.ColumnDefinitions>
           <TextBlock x:Name="TitleText" Grid.Column="0" Text="PC Phone Connect"
                      Foreground="#E6ECF5" FontSize="12" VerticalAlignment="Center"
                      Margin="12,8,8,8" TextTrimming="CharacterEllipsis" />
           <StackPanel Grid.Column="1" Orientation="Horizontal">
               <Button Content="—" Width="42" Padding="0" Margin="0" Click="OnMinimize"
                       ToolTip="Minimise" />
               <Button Content="✕" Width="42" Padding="0" Margin="0" Click="OnCloseFromMenu"
                       ToolTip="Close" />
           </StackPanel>
       </Grid>
   </Border>

   <Grid Grid.Row="1">
   <Grid x:Name="ContentGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <Grid x:Name="ConnectionBar" Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IpBox" Grid.Column="0" Margin="0,0,6,0" Text="192.168.1.50"
                     ToolTip="Phone IP address (shown in the phone app)" />
            <TextBox x:Name="PortBox" Grid.Column="1" Margin="0,0,6,0" Text="6060"
                     ToolTip="Port (shown in the phone app)" />
            <Button x:Name="HistoryButton" Grid.Column="2" Content="▾" Width="30" Padding="0"
                    Margin="0,0,6,0" Click="OnShowHistory"
                    ToolTip="Recent connections" />
            <Button x:Name="ConnectButton" Grid.Column="3" Content="Connect" Click="OnConnectClick"
                    Margin="0" />

            <!-- Recent connections dropdown -->
            <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=IpBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="#16223C" BorderBrush="#2B3B5E" BorderThickness="1"
                        CornerRadius="6" Padding="4" Margin="0,2,0,0" MinWidth="260">
                    <StackPanel>
                        <TextBlock x:Name="HistoryHeader" Text="Recent connections" Margin="6,4,6,6"
                                   FontSize="11" Foreground="#7C89A6" />
                        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                                 Foreground="#E6ECF5" MaxHeight="240"
                                 PreviewMouseLeftButtonUp="OnHistoryPick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Foreground" Value="#E6ECF5" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ib" Background="Transparent"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ib" Property="Background" Value="#2B3B5E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Phone frame -->
        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Border x:Name="PhoneBezel" Background="Black" CornerRadius="34" Padding="10"
                    Width="360" Height="740">
                <Border CornerRadius="26" ClipToBounds="True" Background="#05070C">
                    <Grid>
                        <Image x:Name="ScreenImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="OnScreenMouseDown"
                               MouseLeftButtonUp="OnScreenMouseUp"
                               MouseMove="OnScreenMouseMove"
                               LostMouseCapture="OnScreenLostCapture"
                               MouseRightButtonUp="OnScreenRightUp"
                               MouseWheel="OnScreenWheel" />
                        <TextBlock x:Name="Placeholder" Text="Not connected"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#5A6B8C" FontSize="18" />
                    </Grid>
                </Border>
            </Border>
        </Viewbox>

        <!-- Navigation buttons -->
        <StackPanel x:Name="NavBar" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,6">
            <Button x:Name="BackButton" Content="◀  Back" Click="OnBackClick" IsEnabled="False" />
            <Button x:Name="HomeButton" Content="●  Home" Click="OnHomeClick" IsEnabled="False" />
            <Button x:Name="RecentsButton" Content="■  Recents" Click="OnRecentsClick" IsEnabled="False" />
            <Button x:Name="NotificationsButton" Content="▾  Notifs" Click="OnNotificationsClick" IsEnabled="False" />
        </StackPanel>

        <!-- Text input: type into the phone's focused field -->
        <Grid x:Name="TextBar" Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="TypeBox"
                         TextChanged="OnTypeChanged"
                         PreviewKeyDown="OnTextInputKeyDown"
                         ToolTip="Tap a text field on the phone first, then type here." />
                <TextBlock IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center"
                           Foreground="#5A6B8C" Text="Type here to type on the phone…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TypeBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" x:Name="ClearFieldButton" Content="⌫ Clear"
                    Click="OnClearField"
                    ToolTip="Clear the focused field on the phone" />
        </Grid>

        <!-- Status bar, with the version pinned to the lower right -->
        <Grid x:Name="StatusBar" Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Text="Enter the phone's IP and port, then Connect."
                       TextWrapping="Wrap" Margin="2,0,8,0" FontSize="12" />
            <TextBlock x:Name="VersionText" Grid.Column="1" Text="v1.50"
                       VerticalAlignment="Bottom" HorizontalAlignment="Right"
                       Margin="0,0,2,0" FontSize="11" Foreground="#5A6B8C" />
        </Grid>
   </Grid>

   <!-- Side tab: opens the messages panel -->
   <Button x:Name="MessagesTab" HorizontalAlignment="Right" VerticalAlignment="Center"
           Margin="0,0,0,150" Width="30" Height="120" Padding="0" Click="OnToggleMessages"
           ToolTip="Messages">
       <TextBlock Text="MSGS" FontSize="12" FontWeight="SemiBold" Foreground="#E6ECF5">
           <TextBlock.LayoutTransform>
               <RotateTransform Angle="90" />
           </TextBlock.LayoutTransform>
       </TextBlock>
   </Button>

   <!-- Messages panel -->
   <Border x:Name="MessagesPanel" Visibility="Collapsed"
           HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="400"
           Background="#111C31" BorderBrush="#2B3B5E" BorderThickness="1,0,0,0">
       <Grid Margin="14">
           <Grid.RowDefinitions>
               <RowDefinition Height="Auto" />
               <RowDefinition Height="*" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
           </Grid.RowDefinitions>

           <Grid Grid.Row="0" Margin="0,0,0,10">
               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                   <Button x:Name="MsgBackButton" Content="◀" Width="30" Padding="0"
                           Margin="0,0,8,0" Visibility="Collapsed" Click="OnMessagesBack"
                           ToolTip="Back" />
                   <TextBlock x:Name="MessagesHeading" Text="Messages" Foreground="#E6ECF5"
                              FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                              TextTrimming="CharacterEllipsis" MaxWidth="200" />
               </StackPanel>
               <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                   <Button x:Name="SmsHistoryButton" Content="History" Padding="10,6"
                           Click="OnShowSmsHistory" ToolTip="Browse SMS conversations on the phone" />
                   <Button Content="⟳" Width="30" Padding="0" Click="OnRefreshMessages"
                           ToolTip="Fetch conversations currently on the phone" />
                   <Button Content="✕" Width="30" Padding="0" Click="OnToggleMessages" />
               </StackPanel>
           </Grid>

           <Border Grid.Row="1" Background="#0B1424" BorderBrush="#2B3B5E" BorderThickness="1"
                   CornerRadius="6">
               <ListBox x:Name="MessageList" Background="Transparent" BorderThickness="0"
                        Foreground="#E6ECF5" HorizontalContentAlignment="Stretch"
                        MouseDoubleClick="OnMessageListDoubleClick">
                   <ListBox.ItemContainerStyle>
                       <Style TargetType="ListBoxItem">
                           <Setter Property="Padding" Value="8,6" />
                           <Setter Property="Foreground" Value="#E6ECF5" />
                           <Setter Property="Template">
                               <Setter.Value>
                                   <ControlTemplate TargetType="ListBoxItem">
                                       <Border x:Name="mb" Background="Transparent" CornerRadius="4"
                                               Padding="{TemplateBinding Padding}">
                                           <ContentPresenter />
                                       </Border>
                                       <ControlTemplate.Triggers>
                                           <Trigger Property="IsMouseOver" Value="True">
                                               <Setter TargetName="mb" Property="Background" Value="#22314F" />
                                           </Trigger>
                                           <Trigger Property="IsSelected" Value="True">
                                               <Setter TargetName="mb" Property="Background" Value="#2B3B5E" />
                                           </Trigger>
                                       </ControlTemplate.Triggers>
                                   </ControlTemplate>
                               </Setter.Value>
                           </Setter>
                       </Style>
                   </ListBox.ItemContainerStyle>
               </ListBox>
           </Border>

           <Grid Grid.Row="2" Margin="0,10,0,0">
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="*" />
                   <ColumnDefinition Width="Auto" />
               </Grid.ColumnDefinitions>
               <TextBox x:Name="ReplyBox" Grid.Column="0" Margin="0,0,6,0"
                        KeyDown="OnReplyKeyDown"
                        ToolTip="Select a conversation, type a reply, press Enter" />
               <Button Grid.Column="1" Content="Send" Click="OnSendReply" Margin="0" />
           </Grid>

           <TextBlock x:Name="MessagesStatus" Grid.Row="3" Margin="2,10,0,0" FontSize="11"
                      TextWrapping="Wrap"
                      Text="Messages arrive here as they do on the phone." />
       </Grid>
   </Border>

   <!-- Side tab: opens the file transfer panel -->
   <Button x:Name="FilesTab" HorizontalAlignment="Right" VerticalAlignment="Center"
           Width="30" Height="120" Margin="0" Padding="0" Click="OnToggleFiles"
           ToolTip="File transfer">
       <Button.LayoutTransform>
           <RotateTransform Angle="0" />
       </Button.LayoutTransform>
       <TextBlock Text="FILES" FontSize="12" FontWeight="SemiBold" Foreground="#E6ECF5">
           <TextBlock.LayoutTransform>
               <RotateTransform Angle="90" />
           </TextBlock.LayoutTransform>
       </TextBlock>
   </Button>

   <!-- File transfer panel -->
   <Border x:Name="FilePanel" Visibility="Collapsed"
           HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="400"
           Background="#111C31" BorderBrush="#2B3B5E" BorderThickness="1,0,0,0">
       <Grid Margin="14">
           <Grid.RowDefinitions>
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="*" />
               <RowDefinition Height="Auto" />
               <RowDefinition Height="Auto" />
           </Grid.RowDefinitions>

           <!-- Title -->
           <Grid Grid.Row="0" Margin="0,0,0,10">
               <TextBlock Text="File transfer" Foreground="#E6ECF5"
                          FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
               <Button Content="✕" Width="30" Padding="0" HorizontalAlignment="Right"
                       Click="OnToggleFiles" />
           </Grid>

           <!-- Local (PC) folder -->
           <StackPanel Grid.Row="1" Margin="0,0,0,10">
               <TextBlock Text="PC folder (downloads land here)" FontSize="11" Margin="2,0,0,4" />
               <Grid>
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="*" />
                       <ColumnDefinition Width="Auto" />
                   </Grid.ColumnDefinitions>
                   <TextBox x:Name="LocalDirBox" Grid.Column="0" Margin="0,0,6,0"
                            TextChanged="OnLocalDirChanged" />
                   <Button Grid.Column="1" Content="Browse…" Click="OnBrowseLocal" Margin="0" />
               </Grid>
           </StackPanel>

           <!-- Remote (phone) folder -->
           <StackPanel Grid.Row="2" Margin="0,0,0,8">
               <TextBlock Text="Phone folder (uploads land here)" FontSize="11" Margin="2,0,0,4" />
               <Grid>
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition Width="Auto" />
                       <ColumnDefinition Width="*" />
                       <ColumnDefinition Width="Auto" />
                   </Grid.ColumnDefinitions>
                   <Button Grid.Column="0" Content="↑" Width="30" Padding="0" Margin="0,0,6,0"
                           Click="OnPhoneUp" ToolTip="Up one folder" />
                   <TextBox x:Name="RemoteDirBox" Grid.Column="1" Margin="0,0,6,0"
                            KeyDown="OnRemoteDirKey" />
                   <Button Grid.Column="2" Content="Go" Click="OnRemoteGo" Margin="0" />
               </Grid>
           </StackPanel>

           <!-- Phone file list -->
           <Border Grid.Row="3" Background="#0B1424" BorderBrush="#2B3B5E" BorderThickness="1"
                   CornerRadius="6">
               <ListBox x:Name="PhoneFiles" Background="Transparent" BorderThickness="0"
                        Foreground="#E6ECF5" MouseDoubleClick="OnPhoneFileOpen">
                   <ListBox.ItemContainerStyle>
                       <Style TargetType="ListBoxItem">
                           <Setter Property="Padding" Value="8,5" />
                           <Setter Property="Foreground" Value="#E6ECF5" />
                           <Setter Property="Template">
                               <Setter.Value>
                                   <ControlTemplate TargetType="ListBoxItem">
                                       <Border x:Name="fb" Background="Transparent" CornerRadius="4"
                                               Padding="{TemplateBinding Padding}">
                                           <ContentPresenter />
                                       </Border>
                                       <ControlTemplate.Triggers>
                                           <Trigger Property="IsMouseOver" Value="True">
                                               <Setter TargetName="fb" Property="Background" Value="#22314F" />
                                           </Trigger>
                                           <Trigger Property="IsSelected" Value="True">
                                               <Setter TargetName="fb" Property="Background" Value="#2B3B5E" />
                                           </Trigger>
                                       </ControlTemplate.Triggers>
                                   </ControlTemplate>
                               </Setter.Value>
                           </Setter>
                       </Style>
                   </ListBox.ItemContainerStyle>
               </ListBox>
           </Border>

           <!-- Transfer buttons -->
           <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,10,0,0">
               <Button x:Name="DownloadButton" Content="⬇  Download to PC" Click="OnDownload"
                       Margin="0,0,0,6"
                       ToolTip="Copy the selected phone file or folder to the PC folder" />
               <StackPanel Orientation="Horizontal">
                   <Button x:Name="UploadButton" Content="⬆  Files to phone…" Click="OnUpload"
                           ToolTip="Send PC files to the phone folder" />
                   <Button x:Name="UploadFolderButton" Content="⬆  Folder to phone…"
                           Click="OnUploadFolder"
                           ToolTip="Send a whole PC folder to the phone folder" />
               </StackPanel>
           </StackPanel>

           <TextBlock x:Name="TransferStatus" Grid.Row="5" Margin="2,10,0,0" FontSize="11"
                      TextWrapping="Wrap" Text="Double-click a folder to open it." />
       </Grid>
   </Border>
   </Grid>
  </Grid>
  </Border>
</Window>
