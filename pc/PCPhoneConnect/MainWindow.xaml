<Window x:Class="PCPhoneConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Phone Connect" Height="820" Width="460"
        MinHeight="600" MinWidth="360" Icon="app.ico"
        Background="#0E1726" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2A44" />
            <Setter Property="Foreground" Value="#E6ECF5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2B3B5E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A2540" />
            <Setter Property="Foreground" Value="#E6ECF5" />
            <Setter Property="BorderBrush" Value="#2B3B5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#E6ECF5" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB6CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IpBox" Grid.Column="0" Margin="0,0,8,0" Text="192.168.1.50"
                     ToolTip="Phone IP address (shown in the phone app). Click for recent connections."
                     GotKeyboardFocus="OnAddressFieldFocus" />
            <TextBox x:Name="PortBox" Grid.Column="1" Margin="0,0,8,0" Text="6060"
                     GotKeyboardFocus="OnAddressFieldFocus" />
            <Button x:Name="ConnectButton" Grid.Column="2" Content="Connect" Click="OnConnectClick" />

            <!-- Recent connections dropdown -->
            <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=IpBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="#16223C" BorderBrush="#2B3B5E" BorderThickness="1"
                        CornerRadius="6" Padding="4" Margin="0,2,0,0" MinWidth="230">
                    <StackPanel>
                        <TextBlock Text="Recent connections" Margin="6,4,6,6"
                                   FontSize="11" Foreground="#7C89A6" />
                        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0"
                                 Foreground="#E6ECF5" MaxHeight="240"
                                 PreviewMouseLeftButtonUp="OnHistoryPick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Foreground" Value="#E6ECF5" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ib" Background="Transparent"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ib" Property="Background" Value="#2B3B5E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Phone frame -->
        <Viewbox Grid.Row="1" Stretch="Uniform">
            <Border x:Name="PhoneBezel" Background="Black" CornerRadius="34" Padding="10"
                    Width="360" Height="740">
                <Border CornerRadius="26" ClipToBounds="True" Background="#05070C">
                    <Grid>
                        <Image x:Name="ScreenImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="OnScreenMouseDown"
                               MouseLeftButtonUp="OnScreenMouseUp"
                               MouseMove="OnScreenMouseMove"
                               MouseRightButtonUp="OnScreenRightUp"
                               MouseWheel="OnScreenWheel" />
                        <TextBlock x:Name="Placeholder" Text="Not connected"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#5A6B8C" FontSize="18" />
                    </Grid>
                </Border>
            </Border>
        </Viewbox>

        <!-- Navigation buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,6">
            <Button x:Name="BackButton" Content="◀  Back" Click="OnBackClick" IsEnabled="False" />
            <Button x:Name="HomeButton" Content="●  Home" Click="OnHomeClick" IsEnabled="False" />
            <Button x:Name="RecentsButton" Content="■  Recents" Click="OnRecentsClick" IsEnabled="False" />
            <Button x:Name="NotificationsButton" Content="▾  Notifs" Click="OnNotificationsClick" IsEnabled="False" />
        </StackPanel>

        <!-- Text input: type into the phone's focused field -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <TextBox x:Name="TypeBox"
                         TextChanged="OnTypeChanged"
                         PreviewKeyDown="OnTextInputKeyDown"
                         ToolTip="Tap a text field on the phone first, then type here." />
                <TextBlock IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center"
                           Foreground="#5A6B8C" Text="Type here to type on the phone…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TypeBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button Grid.Column="1" x:Name="ClearFieldButton" Content="⌫ Clear"
                    Click="OnClearField"
                    ToolTip="Clear the focused field on the phone" />
        </Grid>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="Enter the phone's IP and port, then Connect."
                   TextWrapping="Wrap" Margin="2,6,0,0" FontSize="12" />
    </Grid>
</Window>
